{
  "name": "ai-sdd-seed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "description": "Memoria vectorizada + caché semántica para el proyecto base .NET 10 (corpus de docs/skills embebido con bge-m3 local vía transformers.js).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "vectorize:project": "node scripts/vectorize/index.mjs",
    "vectorize:test": "node scripts/vectorize/test-query.mjs",
    "memory:lookup": "node scripts/memory/lookup.mjs",
    "memory:file-read": "node scripts/memory/file-read.mjs",
    "memory:semantic-cache": "node scripts/memory/semantic-cache.mjs",
    "doctor": "node scripts/doctor/check-environment.mjs",
    "tooling": "node scripts/cli/tooling.mjs"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2",
    "figlet": "^1.11.4",
    "inquirer": "^14.2.2"
  }
}
